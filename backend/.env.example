# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=debug

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/adgenious

# JWT Configuration
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace-with-a-32-byte-encryption-key

# Product configuration
SIGNUP_CREDITS=50

# Meta (Facebook / Instagram) Configuration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_API_VERSION=v19.0
META_REDIRECT_URI=http://localhost:5001/api/auth/facebook/callback

# OpenRouter (AI generation)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=openai/dall-e-3

# Stripe Billing
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Credit costs
CREDITS_TEXT_COST=1
CREDITS_IMAGE_COST=10
CREDITS_VIDEO_COST=50
